{
  "schemaVersion": 1,
  "id": "affogatotweaks",
  "version": "${version}",
  "name": "Affogato Tweaks",
  "description": "Tweak mod used in my modpack, Affogato",
  "authors": ["pajic"],
  "contact": {},
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "me.pajic.affogatotweaks.Main"
    ],
    "client": [
      "me.pajic.affogatotweaks.ClientMain"
